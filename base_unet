    "class DiceLoss(nn.Module):\n",
    "    def __init__(self, weight = None, size_average=True):\n",
    "        super(DiceLoss, self).__init__()\n",
    "\n",
    "    def forward(self, inputs, targets, smooth_size=1):\n",
